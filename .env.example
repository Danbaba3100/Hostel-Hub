# Deployment environment template for Render. Set real secrets in the Render dashboard; never commit credentials.
NODE_ENV=production
PORT=10000
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_NEON_HOST/hostel_hub?sslmode=require
DATABASE_SSL=true
DB_POOL_MAX=10

# Generate a strong random secret (at least 32 bytes). Keep it private.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_ACCESS_TTL=15m

# Comma-separated exact frontend origins for the deployed site:
CORS_ORIGINS=https://hostel-hub-frontend.onrender.com

# Set to the number of trusted reverse proxies in your deployment, otherwise leave 0.
TRUST_PROXY=0

# Temporary one-time admin provisioning variables; set only when running create-admin.
# Remove these values after the command completes.
CONFIRM_CREATE_ADMIN=
ADMIN_FULL_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=

# WhatsApp credentials will be added in the notifications phase.
WHATSAPP_PROVIDER=
WHATSAPP_API_TOKEN=
WHATSAPP_SENDER_ID=