# Copy this file to .env locally. Never commit real credentials.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/hostel_hub
DATABASE_SSL=false
DB_POOL_MAX=10

# Generate a strong random secret (at least 32 bytes). Keep it private.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_ACCESS_TTL=15m

# Comma-separated exact frontend origins. Example for local testing:
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Set to the number of trusted reverse proxies in your deployment, otherwise leave 0.
TRUST_PROXY=0

# Temporary one-time admin provisioning variables; set only when running create-admin.
# Remove these values after the command completes.
CONFIRM_CREATE_ADMIN=
ADMIN_FULL_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=

# WhatsApp credentials will be added in the notifications phase.
WHATSAPP_PROVIDER=
WHATSAPP_API_TOKEN=
WHATSAPP_SENDER_ID=